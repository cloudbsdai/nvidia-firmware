#!/bin/sh
#
# Take the firmware out of /boot before the package goes away.  The nvidia
# module must not be loaded while the files are removed, and the state of
# the module has to be known: a state that cannot be found out stops the
# removal as well.
#
# The check and the removal are one thing here, and the tool does both of
# them under its lock: the state of the module is read once, under the
# lock, and the files are taken away while the lock is held.  A check in
# this script and a removal in the tool would leave a moment in between
# in which the module could be loaded, and the firmware would be taken
# away while the driver uses it.
#
# pkg(8) runs this script when the package is removed.  The first
# argument is the name of the package and the second one is the phase:
# the firmware is taken out in the DEINSTALL phase, when the files of
# the package are still there.  In every other phase the script does
# nothing.
#
# The prefix of the package is PKG_PREFIX.  PREFIX is only used when the
# script is run by hand.

PKG_PREFIX=${PKG_PREFIX:-${PREFIX:-/usr/local}}
TOOL=${PKG_PREFIX}/sbin/nvidia-firmware

case "${2:-}" in
DEINSTALL)
	;;
*)
	exit 0
	;;
esac

# The tool is the one that takes the firmware out, and it is the one that
# asks whether the module is loaded.  When it is not there the script
# says so and fails: the package is not removed with the firmware still
# in /boot/firmware/nvidia.
if [ ! -x "${TOOL}" ]; then
	echo "nvidia-firmware is not installed in ${PKG_PREFIX}; the firmware" \
	    "in /boot/firmware/nvidia was not taken out." >&2
	echo "Remove /boot/firmware/nvidia by hand." >&2
	exit 1
fi

if ! "${TOOL}" clean; then
	echo "nvidia-firmware clean failed; the firmware is still in" \
	    "/boot/firmware/nvidia." >&2
	echo "Unload the nvidia module and remove the package again." >&2
	exit 1
fi

exit 0
